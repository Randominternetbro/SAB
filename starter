-- ==========================================
-- LÓGICA DE EJECUCIÓN
-- ==========================================

-- Función para ejecutar el script y cerrar la interfaz
local function EjecutarScript(url)
    -- Destruye la interfaz de inmediato
    MenuSelectorUI:Destroy()
    
    -- Intenta cargar y ejecutar el string desde la URL
    local success, result = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    
    -- Opcional: Imprime en la consola si hubo un error al ejecutar
    if not success then
        warn("Hubo un error al intentar ejecutar el script: " .. tostring(result))
    end
end

-- Conectar los clics de los botones a la lógica
Button1.MouseButton1Click:Connect(function()
    EjecutarScript(Config.Boton1.URL)
end)

Button2.MouseButton1Click:Connect(function()
    EjecutarScript(Config.Boton2.URL)
end)
