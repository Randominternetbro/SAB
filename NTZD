task.spawn(function()
    while true do
        task.wait(0.05)
        local isStealing = lp:GetAttribute("Stealing") == true

        if isStealing and not State.isDelaying and State.enabled then
            State.isDelaying = true
            activateDesync()

            -- Salva snapshot da posição ANTES de qualquer wait
            local char = lp.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                fakeServerPos   = hrp.Position
                safePosSnapshot = hrp.Position
                safeCFSnapshot  = hrp.CFrame
            end

            -- 1 único rollback, sem delay para evitar double-trigger
            SafeRollback()
            -- Mantém desync ativo (SafeRollback pausa e restaura internamente)

            -- Timer visual apenas — SEM rollback adicional ao fim
            State.timer = CYCLE_TIME
            while State.timer > 0 and lp:GetAttribute("Stealing") == true and State.enabled do
                statusText.Text = string.format("%.1fs", State.timer)
                local pct = math.clamp(1 - (State.timer / CYCLE_TIME), 0, 1)
                progressFill.Size = UDim2.new(pct, 0, 1, 0)
                if State.timer <= 2.0 then
                    statusText.TextColor3 = RED_BRIGHT; progressFill.BackgroundColor3 = RED
                else
                    statusText.TextColor3 = WHITE_COLOR; progressFill.BackgroundColor3 = WHITE_COLOR
                end
                statusText.Visible = true
                task.wait(0.05)
                State.timer = math.max(0, State.timer - 0.05)
            end

            progressFill.Size = UDim2.new(0, 0, 1, 0); progressFill.BackgroundColor3 = WHITE_COLOR
            State.isDelaying = false

        elseif not isStealing or not State.enabled then
            if State.desync then deactivateDesync() end
            State.isDelaying = false; statusText.Visible = true; statusText.TextSize = 14
            statusText.Text = State.enabled and "Waiting..." or "DISABLED"
            statusText.TextColor3 = State.enabled and GRAY_MID or RED_BRIGHT
            progressFill.Size = UDim2.new(0, 0, 1, 0)
            fakeServerPos = nil
        end
    end
end)

