-- ════════════════════════════════════════════
--  ROLLBACK — VAI 6 STUDS PARA TRÁS
-- ════════════════════════════════════════════
local function SafeRollback()
    local ok, err = pcall(function()
        local char = lp.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local wasDesync = State.desync
        State.desync = false
        if mobileDesyncOk then pcall(function() raknet.desync(false) end) end

        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        local currentPos = hrp.Position
        local currentCF  = hrp.CFrame

        local backVec   = -currentCF.LookVector
        local targetPos = Vector3.new(
            currentPos.X + backVec.X * BEHIND_OFFSET,
            currentPos.Y,
            currentPos.Z + backVec.Z * BEHIND_OFFSET
        )

        hrp.CFrame = CFrame.new(targetPos, targetPos + currentCF.LookVector)
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        fakeServerPos = targetPos

        task.wait(0.06)

        if wasDesync and lp:GetAttribute("Stealing") == true then
            State.desync = true
            if mobileDesyncOk then pcall(function() raknet.desync(true) end) end
        end
    end)
    if not ok then
        print("[NotzHub] Rollback falhou: " .. tostring(err))
    end
end

-- ════════════════════════════════════════════
--  HOOKS DE DESYNC (PC) – seguro
-- ════════════════════════════════════════════
task.spawn(function()
    for _ = 1, 40 do
        local ok = pcall(function()
            if not raknet or not raknet.add_send_hook then error("nil") end
            raknet.add_send_hook(function(packet)
                pcall(function()
                    if State.desync and State.enabled
                       and packet.PacketId == 0x1B then
                        local b = packet.AsBuffer
                        if b then
                            pcall(function()
                                buffer.writeu32(b, 1, 0xFFFFFFFF)
                                buffer.writeu32(b, 5, 0xFFFFFFFF)
                                buffer.writeu32(b, 9, 0xFFFFFFFF)
                                packet:SetData(b)
                            end)
                        end
                    end
                end)
            end)
            pcall(function()
                raknet.add_recv_hook(function(packet)
                    pcall(function()
                        if State.desync and State.enabled then
                            if packet.PacketId == 0x1B or packet.PacketId == 0x86
                               or packet.PacketId == 0x21 then
                                packet:Drop()
                            end
                        end
                    end)
                end)
            end)
        end)
        if ok then return end
        task.wait(0.5)
    end
end)

pcall(function()
    if raknet and raknet.desync then mobileDesyncOk = true end
end)

local function activateDesync()
    State.desync   = true
    State.stealing = true
    if mobileDesyncOk then pcall(function() raknet.desync(true) end) end
end

local function deactivateDesync()
    State.desync   = false
    State.stealing = false
    if mobileDesyncOk then pcall(function() raknet.desync(false) end) end
end

