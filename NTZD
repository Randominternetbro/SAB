local function SaveConfig()
    pcall(function()
        writefile(CFG_FILE, HttpSvc:JSONEncode({
            X        = { Scale = main.Position.X.Scale, Offset = main.Position.X.Offset },
            Y        = { Scale = main.Position.Y.Scale, Offset = main.Position.Y.Offset },
            Key      = rollbackKey.Name,
            CycleTime = CYCLE_TIME,
        }))
    end)
end

local function LoadConfig()
    local defPos = UDim2.new(0.02, 0, 0.3, 0)
    local defKey = Enum.KeyCode.R
    local defCycle = 6.0
    if isfile and isfile(CFG_FILE) then
        local ok, d = pcall(function() return HttpSvc:JSONDecode(readfile(CFG_FILE)) end)
        if ok and d then
            local pos = UDim2.new(d.X.Scale, d.X.Offset, d.Y.Scale, d.Y.Offset)
            local key = d.Key and (pcall(function() return Enum.KeyCode[d.Key] end)
                        and Enum.KeyCode[d.Key]) or defKey
            local cy  = tonumber(d.CycleTime) or defCycle
            return pos, key, cy
        end
    end
    return defPos, defKey, defCycle
end

local savedPos, savedKey, savedCycle = LoadConfig()
