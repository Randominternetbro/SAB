-- Obtenemos la función de teletransporte compatible con tu ejecutador
local queue_on_teleport = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)

local ScriptCode = [[
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local targetPlaceId = 109983668079237 
local configName = "BerUI_Position.json"

-- Función para cargar la posición guardada (Intacta)
local function loadPosition()
    if isfile and isfile(configName) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(configName))
        end)
        if success and data and data.X and data.Y then
            return UDim2.new(0, data.X, 0, data.Y)
        end
    end
    return UDim2.new(0.5, -75, 0.5, -50)
end

-- Función para guardar la posición actual (Intacta)
local function savePosition(pos)
    if writefile then
        local data = {
            X = pos.X.Offset,
            Y = pos.Y.Offset
        }
        writefile(configName, HttpService:JSONEncode(data))
    end
end

-- Limpiar interfaz anterior si existe
for _, gui in ipairs(CoreGui:GetChildren()) do
    if gui.Name == "VexisPanelGUI" then
        gui:Destroy()
    end
end

-- Crear GUI Principal
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "VexisPanelGUI"
ScreenGui.ResetOnSpawn = false

if gethui then
    ScreenGui.Parent = gethui()
elseif syn and syn.protect_gui then
    syn.protect_gui(ScreenGui)
    ScreenGui.Parent = CoreGui
else
    ScreenGui.Parent = CoreGui
end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 160, 0, 125)
MainFrame.Position = loadPosition()
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.BackgroundTransparency = 0.15
MainFrame.BorderSizePixel = 0
