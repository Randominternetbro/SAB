RejoinButton.MouseLeave:Connect(function() RejoinStroke.Color = Color3.fromRGB(50, 50, 60) end)

-- Lógica de Arrastre (Dragging) y Guardado de Posición (Intacta)
local dragging = false
local dragInput, mousePos, framePos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        mousePos = input.Position
        framePos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                savePosition(MainFrame.Position)
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - mousePos
        MainFrame.Position = UDim2.new(
            framePos.X.Scale, 
            framePos.X.Offset + delta.X, 
            framePos.Y.Scale, 
            framePos.Y.Offset + delta.Y
        )
    end
end)

-- NUEVA LÓGICA DE SERVER HOP (Filtrado de servidores inteligente)
HopButton.MouseButton1Click:Connect(function()
    HopButton.Text = "Searching..."
    
    task.spawn(function()
        local historyFile = "BerUI_HopHistory.json"
        local history = {}
        
        -- Cargar historial de servidores visitados
        if isfile and isfile(historyFile) then
            pcall(function()
                history = HttpService:JSONDecode(readfile(historyFile))
            end)
        end
        if type(history) ~= "table" then history = {} end
        
        -- Añadir el servidor actual al historial si no está registrado
        if game.JobId and game.JobId ~= "" then
            local exists = false
            for _, id in ipairs(history) do
                if id == game.JobId then exists = true break end
            end
            if not exists then
                table.insert(history, game.JobId)
                if #history > 6 then table.remove(history, 1) end -- Guarda registro de los últimos 6 servidores
                if writefile then
                    writefile(historyFile, HttpService:JSONEncode(history))
                end
            end
        end
        
        -- Obtener servidores públicos activos del PlaceID
        local success, serverListRaw = pcall(function()
            return game:HttpGet("https://games.roblox.com/v1/games/" .. targetPlaceId .. "/servers/Public?sortOrder=Desc&limit=100")
        end)
        
        if success and serverListRaw then
            local decodeSuccess, serverList = pcall(function() return HttpService:JSONDecode(serverListRaw) end)
            if decodeSuccess and serverList and serverList.data then
                local validServers = {}
                
                for _, server in ipairs(serverList.data) do
                    if server.id and server.playing and server.maxPlayers and server.playing < server.maxPlayers then
                        -- Comprobar si el servidor está en el historial reciente
                        local isRecent = false
                        for _, oldId in ipairs(history) do
                            if oldId == server.id then
                                isRecent = true
                                break
                            end
                        end
                        if not isRecent then
                            table.insert(validServers, server.id)
                        end
                    end
                end
                
                -- Si hay servidores disponibles que no hemos visitado, ir a uno aleatorio
                if #validServers > 0 then
                    local chosenServer = validServers[math.random(1, #validServers)]
                    
                    table.insert(history, chosenServer)
                    if #history > 6 then table.remove(history, 1) end
                    if writefile then
                        writefile(historyFile, HttpService:JSONEncode(history))
                    end
                    
                    HopButton.Text = "Teleporting..."
                    TeleportService:TeleportToPlaceInstance(targetPlaceId, chosenServer, LocalPlayer)
                    return
                end
            end
        end
        
        -- Fallback normal si la API falla o no hay servidores alternativos válidos
        HopButton.Text = "Standard Hop..."
        TeleportService:Teleport(targetPlaceId, LocalPlayer)
    end)
end)

-- Lógica de Rejoin (Intacta)
RejoinButton.MouseButton1Click:Connect(function()
    RejoinButton.Text = "Rejoining..."
    if #Players:GetPlayers() <= 1 then
        LocalPlayer:Kick("Rejoining...")
        task.wait()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end)
]]

-- 1. Ejecutamos de forma normal al inyectar
loadstring(ScriptCode)()

-- 2. Manejo automático del persistido en teletransportes
if queue_on_teleport then
    game:GetService("Players").LocalPlayer.OnTeleport:Connect(function(teleportState)
        if teleportState == Enum.TeleportState.Started then
            queue_on_teleport(ScriptCode)
        end
    end)
end
